   "description": "Running example g=a&b&c, K={a:1,b:1}: UNKNOWN, only c is relevant",
   "rules": {
    "g": {
     "all": [
      "a",
      "b",
      "c"
     ]
    }
   },
   "goal": "g",
   "evidence": {
    "a": true,
    "b": true
   },
   "expected": {
    "status": "UNKNOWN",
    "certificate": null,
    "relevant_unknowns": [
     "c"
    ],
    "witnesses": {
     "true": {
      "a": true,
      "b": true,
      "c": true
